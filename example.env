# TrainConfig environment overrides
# Loaded by your shell or dotenv tooling before running scripts/train.py

MODEL_TYPE=quantile
FORECAST_HORIZON=12
TARGET_COL=no2

NUM_EPOCHS=10
LR=0.001

# JSON arrays
TEMPORAL_FEATURE_COLS=["day_of_week","hour_sin","hour_cos","doy_sin","doy_cos"]
MEASUREMENTS_FEATURE_COLS=["temp","feuchte","windge","no2"]
SPATIAL_FEATURE_COLS=["station_code"]
LAGS=[1,2,3,6,12,24]

# ISO datetimes
START=2026-01-01T00:00:00
END=2026-03-31T00:00:00

RETRIEVE_NEW_MEASUREMENTS=true
SELECT_FEATURES=false
